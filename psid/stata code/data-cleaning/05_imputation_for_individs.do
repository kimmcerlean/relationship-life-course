* This files uses the wide data and examines multiple methods of imputing missing data

********************************************************************************
* Stata MI Impute
********************************************************************************
use "$created_data/individs_by_duration_wide.dta", clear

browse if inlist(unique_id, 16032, 16176)
browse unique_id partner_unique_id eligible_rel_start_year eligible_rel_end_year ended eligible_rel_status rel_type_constant min_dur max_dur marst_imp* partnered_imp* first_couple_year last_couple_year 
browse unique_id partner_unique_id is_respondent_focal* 

misstable summarize FIRST_BIRTH_YR age_focal* birth_yr_all SEX raceth_fixed_focal fixed_education sample_type eligible_rel_start_year birth_timing_rel rel_type_constant eligible_rel_no current_parent_status* is_respondent_focal* RESPONDENT_WHO_* retired_est_focal*, all

egen nmis_workhrs = rmiss(weekly_hrs_t_focal*)
tab nmis_workhrs, m

egen nmis_hwhrs = rmiss(housework_focal*)
tab nmis_hwhrs, m

egen nmis_employ = rmiss(employment_status_focal*)
tab nmis_employ, m

egen nmis_age = rmiss(age_focal*)
tab nmis_age, m

egen nmis_respondent = rmiss(is_respondent_focal*)
tab nmis_respondent, m

// drop if nmis_age==17 // for now, just so this is actually complete
drop if birth_yr_all==. // for now, just so this is actually complete
drop if raceth_fixed_focal==. // so actually complete
drop if fixed_education==.

